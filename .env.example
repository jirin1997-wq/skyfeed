# Database (Supabase)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres"

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URL (for CORS)
# Development: http://localhost:3000
# Production: https://skyfeed.vercel.app
FRONTEND_URL=https://skyfeed.vercel.app
